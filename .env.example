# Django
SECRET_KEY=change-me-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=breathe.settings.local
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional — omit for SQLite local dev)
DATABASE_URL=postgres://breathe:breathe@localhost:5432/breathe_esg

# CORS (comma-separated origins for production)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Docker: set RUN_SEED=1 on first backend start to load demo data
RUN_SEED=0

# Frontend (Vite dev proxy targets backend)
VITE_API_BASE_URL=
